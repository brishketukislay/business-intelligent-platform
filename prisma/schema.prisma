generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String?
  role         String   @default("USER")
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  resetTokens     PasswordResetToken[]
  businessModels  BusinessModel[]
  workingValues   WorkingValue[]
  savedModels     SavedModel[]
  scenarios       Scenario[]
  modelAccess     BusinessModelAccess[]
  analyticsCharts AnalyticsChart[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BusinessModel {
  id          String   @id @default(cuid())
  name        String
  description String?
  modelType   String   @default("CUSTOM")
  status      String   @default("ACTIVE")
  createdBy   String
  createdAt   DateTime @default(now())
  itemLabelSingular String @default("Item")
  itemLabelPlural   String @default("Items")

  creator User @relation(fields: [createdBy], references: [id])
  settings        BusinessModelSettings?
  inputs          InputDefinition[]
  metrics         MetricDefinition[]
  periods         ModelPeriod[]
  items           ModelItem[]
  savedValues     SavedModelValue[]
  savedModels     SavedModel[]
  scenarios       Scenario[]
  access          BusinessModelAccess[]
  analyticsCharts AnalyticsChart[]
}

model BusinessModelSettings {
  id                   String @id @default(cuid())
  modelId              String @unique
  currency             String @default("GBP")
  fiscalYearStartMonth Int    @default(1)
  periodType           String @default("MONTH")

  model BusinessModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
}

model ModelPeriod {
  id        String   @id @default(cuid())
  modelId   String
  name      String
  key       String
  startDate DateTime
  endDate   DateTime
  sortOrder Int
  status    String   @default("ACTIVE")

  model            BusinessModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  values           PeriodValue[]
  itemValues       ModelItemValue[]
  savedModelValues SavedModelValue[]
  scenarioValues   ScenarioValue[]

  @@unique([modelId, key])
  @@index([modelId, sortOrder])
}

model InputDefinition {
  id       String  @id @default(cuid())
  modelId  String
  name     String
  key      String
  type     String
  unit     String?
  category String?

  /**
   * MODEL
   * PERIOD
   * ITEM
   * ITEM_PERIOD
   */
  scope String @default("MODEL")

  status      String   @default("ACTIVE")
  isRequired  Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())

  model BusinessModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  workingValues  WorkingValue[]
  periodValues   PeriodValue[]
  itemValues     ModelItemValue[]
  savedValues    SavedModelValue[]
  scenarioValues ScenarioValue[]

  @@unique([modelId, key])
}

model PeriodValue {
  id        String   @id @default(cuid())
  periodId  String
  inputId   String
  value     String
  updatedAt DateTime @updatedAt

  period ModelPeriod     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  input  InputDefinition @relation(fields: [inputId], references: [id], onDelete: Cascade)

  @@unique([periodId, inputId])
  @@index([periodId])
  @@index([inputId])
}

/**
 * Generic entity within a model.
 * Examples:
 * Project A
 * Project B
 * Project C
 * or:
 * Engineering
 * Sales
 * Marketing
 */
model ModelItem {
  id        String   @id @default(cuid())
  modelId   String
  name      String
  key       String
  status    String   @default("ACTIVE")
  sortOrder Int      @default(0)
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model          BusinessModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  values         ModelItemValue[]
  savedValues    SavedModelValue[]
  scenarioValues ScenarioValue[]

  @@unique([modelId, key])
  @@index([modelId, sortOrder])
}

/**
 * Values belonging to an item.
 * periodId = null
 * -> item-level value
 * periodId != null
 * -> item + period value
 * Example:
 * Project A / estimated_hours / null  / 1000
 * Project A / spent_hours    / Jan   / 100
 * Project A / spent_hours    / Feb   / 120
 */
model ModelItemValue {
  id        String   @id @default(cuid())
  itemId    String
  inputId   String
  periodId  String?
  value     String
  updatedAt DateTime @updatedAt

  item   ModelItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  input  InputDefinition @relation(fields: [inputId], references: [id], onDelete: Cascade)
  period ModelPeriod?    @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([inputId])
  @@index([periodId])
  @@index([itemId, inputId])
  @@index([itemId, periodId])
}

model MetricDefinition {
  id        String   @id @default(cuid())
  modelId   String
  name      String
  key       String
  type      String
  unit      String?
  category  String?
  formula   String
  scope     String   @default("PERIOD")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  model BusinessModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, key])
}

model WorkingValue {
  id        String   @id @default(cuid())
  userId    String
  inputId   String
  value     String
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  input InputDefinition @relation(fields: [inputId], references: [id], onDelete: Cascade)

  @@unique([userId, inputId])
}

model SavedModel {
  id        String   @id @default(cuid())
  modelId   String
  createdBy String
  name      String
  createdAt DateTime @default(now())

  model   BusinessModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  creator User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  values SavedModelValue[]

  @@index([modelId, createdAt])
  @@index([createdBy, createdAt])
}

model SavedModelValue {
  id           String   @id @default(cuid())
  modelId      String
  inputId      String
  savedModelId String?
  periodId     String?
  itemId       String?
  value        String
  createdAt    DateTime @default(now())

  model      BusinessModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  input      InputDefinition @relation(fields: [inputId], references: [id], onDelete: Cascade)
  savedModel SavedModel?     @relation(fields: [savedModelId], references: [id], onDelete: Cascade)
  period     ModelPeriod?    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  item       ModelItem?      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([savedModelId])
  @@index([periodId])
  @@index([itemId])
}

model Scenario {
  id          String   @id @default(cuid())
  modelId     String
  createdBy   String
  name        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  model   BusinessModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  creator User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  values ScenarioValue[]

  @@index([modelId, createdAt])
  @@index([createdBy, createdAt])
}

model ScenarioValue {
  id         String   @id @default(cuid())
  scenarioId String
  inputId    String
  periodId   String?
  itemId     String?
  value      String
  updatedAt  DateTime @updatedAt

  scenario Scenario        @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  input    InputDefinition @relation(fields: [inputId], references: [id], onDelete: Cascade)
  period   ModelPeriod?    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  item     ModelItem?      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([scenarioId])
  @@index([periodId])
  @@index([itemId])
  @@index([scenarioId, inputId])
}

model BusinessModelAccess {
  id         String   @id @default(cuid())
  modelId    String
  userId     String
  permission String   @default("VIEW")
  createdAt  DateTime @default(now())

  model BusinessModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([modelId, userId])
  @@index([modelId])
  @@index([userId])
}

model AnalyticsChart {
  id        String   @id @default(cuid())
  modelId   String
  createdBy String
  name      String
  config    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model   BusinessModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  creator User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([modelId, createdAt])
  @@index([createdBy])
}
