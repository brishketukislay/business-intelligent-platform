generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  name String?

  email String @unique

  role String @default("USER")

  createdAt DateTime @default(now())

  businessModels BusinessModel[]

  workingValues WorkingValue[]

  savedModels SavedModel[]

  scenarios Scenario[]
}

model BusinessModel {
  id String @id @default(cuid())

  name String

  description String?

  status String @default("ACTIVE")

  createdBy String

  createdAt DateTime @default(now())

  creator User @relation(fields: [createdBy], references: [id])

  inputs InputDefinition[]

  metrics MetricDefinition[]

  savedValues SavedModelValue[]

  savedModels SavedModel[]

  scenarios Scenario[]
}

model InputDefinition {
  id String @id @default(cuid())

  modelId String

  name String

  key String

  type String

  unit String?

  category String?

  status String @default("ACTIVE")

  createdAt DateTime @default(now())

  model BusinessModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  workingValues WorkingValue[]

  savedValues SavedModelValue[]

  scenarioValues ScenarioValue[]

  @@unique([modelId, key])
}

model MetricDefinition {
  id String @id @default(cuid())

  modelId String

  name String

  key String

  type String

  unit String?

  category String?

  formula String

  status String @default("ACTIVE")

  createdAt DateTime @default(now())

  model BusinessModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, key])
}

model WorkingValue {
  id String @id @default(cuid())

  userId String

  inputId String

  value String

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  input InputDefinition @relation(fields: [inputId], references: [id], onDelete: Cascade)

  @@unique([userId, inputId])
}

model SavedModel {
  id String @id @default(cuid())

  modelId String

  createdBy String

  name String

  createdAt DateTime @default(now())

  model BusinessModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  values SavedModelValue[]

  @@index([modelId, createdAt])
  @@index([createdBy, createdAt])
}

model SavedModelValue {
  id String @id @default(cuid())

  modelId String

  inputId String

  savedModelId String?

  value String

  createdAt DateTime @default(now())

  model BusinessModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  input InputDefinition @relation(fields: [inputId], references: [id], onDelete: Cascade)

  savedModel SavedModel? @relation(fields: [savedModelId], references: [id], onDelete: Cascade)

  @@index([savedModelId])
}

model Scenario {
  id String @id @default(cuid())

  modelId String

  createdBy String

  name String

  description String?

  status String @default("ACTIVE")

  createdAt DateTime @default(now())

  model BusinessModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  values ScenarioValue[]

  @@index([modelId, createdAt])
  @@index([createdBy, createdAt])
}

model ScenarioValue {
  id String @id @default(cuid())

  scenarioId String

  inputId String

  value String

  updatedAt DateTime @updatedAt

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  input InputDefinition @relation(fields: [inputId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, inputId])
  @@index([scenarioId])
}
