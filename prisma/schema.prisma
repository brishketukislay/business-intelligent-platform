generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  name String?

  email String @unique

  role String @default("USER")

  createdAt DateTime @default(now())

  businessModels BusinessModel[]

  workingValues WorkingValue[]
}

model BusinessModel {
  id String @id @default(cuid())

  name String

  description String?

  status String @default("ACTIVE")

  createdBy String

  createdAt DateTime @default(now())

  creator User @relation(fields: [createdBy], references: [id])

  inputs InputDefinition[]

  savedValues SavedModelValue[]
}

model InputDefinition {
  id String @id @default(cuid())

  modelId String

  name String

  key String

  type String

  unit String?

  category String?

  createdAt DateTime @default(now())

  model BusinessModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  workingValues WorkingValue[]

  savedValues SavedModelValue[]

  @@unique([modelId, key])
}

model WorkingValue {
  id String @id @default(cuid())

  userId String

  inputId String

  value String

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  input InputDefinition @relation(fields: [inputId], references: [id], onDelete: Cascade)

  @@unique([userId, inputId])
}

model SavedModelValue {
  id String @id @default(cuid())

  modelId String

  inputId String

  value String

  createdAt DateTime @default(now())

  model BusinessModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  input InputDefinition @relation(fields: [inputId], references: [id], onDelete: Cascade)
}
